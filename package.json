{
  "name": "geocentric-safari-3d",
  "version": "3.0.0",
  "private": true,
  "description": "Geocentric Safari 3D - a GeoSafari-style geography trivia game on a 3D azimuthal-equidistant (flat earth model) disc.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "bake": "node scripts/bake-maps.cjs",
    "start": "node scripts/serve.mjs",
    "bake:vectors": "node scripts/bake-vectors.mjs",
    "bake:tiles": "python3 scripts/bake-tiles.py"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "earcut": "^3.0.2",
    "three": "0.185.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  }
}
